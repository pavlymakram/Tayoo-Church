generator client {
  provider = "prisma-client-js"
}

// PostgreSQL is required for durable serverless/Vercel deployments.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Church {
  id          String   @id @default(uuid())
  name        String
  /// Dynamic English abbreviation code used to build usernames, e.g. `mar_girgis`.
  abbreviation String  @unique
  licenseKey  String   @unique @map("license_key")
  defaultMassPoints    Int      @default(5) @map("default_mass_points")
  defaultServicePoints Int      @default(3) @map("default_service_points")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  users             User[]
  phases            Phase[]
  classes           Class[]
  eventTypes        EventType[]
  pointTransactions PointTransaction[]

  @@map("churches")
}

/// A stage ("مرحلة") such as `1 إعدادي` inside a sector ("قطاع") such as `PREPARATORY`.
/// The abbreviation drives the generated usernames: `mar_girgis_prep1_59201`.
model Phase {
  id                 String   @id @default(uuid())
  churchId           String   @map("church_id")
  name               String
  abbreviation       String
  sector             String
  sectorAbbreviation String   @map("sector_abbreviation")
  sortOrder          Int      @default(0) @map("sort_order")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  church  Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  classes Class[]
  users   User[]

  @@unique([churchId, abbreviation])
  @@index([churchId])
  @@index([churchId, sector])
  @@map("phases")
}

/// Dynamic class ("فصل") created by phase admins inside one stage.
model Class {
  id        String   @id @default(uuid())
  churchId  String   @map("church_id")
  phaseId   String   @map("phase_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  church  Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  phase   Phase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  members User[] @relation("ClassMembers")

  @@unique([churchId, phaseId, name])
  @@index([churchId])
  @@index([phaseId])
  @@map("classes")
}

model User {
  id              String   @id @default(uuid())
  churchId        String?  @map("church_id")
  /// STUDENT | PHASE_SERVANT | PHASE_ADMIN | CHURCH_ADMIN | SUPER_ADMIN
  role            String   @default("STUDENT")
  fullName        String   @map("full_name")
  /// Auto-generated login identifier, e.g. `mar_girgis_prep1_59201`.
  username        String?  @unique
  phone           String
  email           String?
  secondaryPhone  String?  @map("secondary_phone")
  address         String?
  grade           String?
  birthDate       DateTime? @map("birth_date")
  confessionFather String? @map("confession_father")
  fatherJob       String?  @map("father_job")
  motherJob       String?  @map("mother_job")
  isMotherWorking Boolean  @default(false) @map("is_mother_working")
  qrCodeId        String   @unique @default(uuid()) @map("qr_code_id")
  passwordHash    String?  @map("password_hash")
  pinHash         String?  @map("pin_hash")
  roleSecurityCodeHash String? @map("role_security_code_hash")
  /// Auto-generated initial password shown once to the creating admin; cleared when
  /// the owner sets their own password from profile settings.
  initialPassword String?  @map("initial_password")
  /// Assigned stage for students and phase servants.
  phaseId         String?  @map("phase_id")
  /// Assigned class (فصل) inside the stage.
  classId         String?  @map("class_id")
  /// Assigned sector for PHASE_ADMIN (KG | PRIMARY | PREPARATORY | …).
  sector          String?
  /// Only the very first church admin of a church may delete other church admins.
  isFirstAdmin    Boolean  @default(false) @map("is_first_admin")
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  church              Church?            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  phase               Phase?             @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  classRoom           Class?             @relation("ClassMembers", fields: [classId], references: [id], onDelete: SetNull)
  studentTransactions PointTransaction[] @relation("StudentTransactions")
  servantTransactions PointTransaction[] @relation("ServantTransactions")

  @@unique([churchId, phone])
  @@index([churchId])
  @@index([churchId, role], map: "idx_users_church_role")
  @@index([churchId, phaseId])
  @@index([churchId, classId])
  @@index([email])
  @@index([fullName])
  @@index([qrCodeId])
  @@map("users")
}


model EventType {
  id            String   @id @default(uuid())
  churchId      String   @map("church_id")
  title         String
  defaultPoints Int      @default(0) @map("default_points")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  church       Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  transactions PointTransaction[]

  @@index([churchId])
  @@map("event_types")
}

model PointTransaction {
  id            String   @id @default(uuid())
  churchId      String   @map("church_id")
  studentId     String   @map("student_id")
  servantId     String   @map("servant_id")
  eventTypeId   String   @map("event_type_id")
  pointsAmount  Int      @map("points_amount")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  church    Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  student   User      @relation("StudentTransactions", fields: [studentId], references: [id], onDelete: Cascade)
  servant   User      @relation("ServantTransactions", fields: [servantId], references: [id], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)

  @@index([churchId])
  @@index([studentId])
  @@index([createdAt])
  @@index([studentId, churchId], map: "idx_transactions_student_church")
  @@index([createdAt(sort: Desc)], map: "idx_transactions_created")
  @@map("point_transactions")
}
