# Supabase transaction pooler (runtime). Copy the actual host/user from Connect.
# URL-encode special characters in the password; require TLS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Session pooler (IPv4-compatible), used for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Local bootstrap only; not needed in Vercel's runtime environment.
SUPER_ADMIN_PHONE=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="مدير النظام"
# Never enable this against a production database.
SEED_DEMO="false"

